<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash Android 12+: latar krem, kepala Oyen (isi di lingkaran 192 dp
         dari 288 dp), dan logo + tagline per bahasa di bawah. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/cream</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/cream</item>
    </style>
</resources>
