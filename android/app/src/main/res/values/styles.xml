<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash Android < 12: krem, kepala Oyen di tengah, logo di bawah.
         Hilang otomatis saat Flutter menggambar bingkai pertama. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Latar jendela di belakang Flutter: krem seperti layar game, supaya
         tidak ada kedip putih sesudah splash. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/cream</item>
    </style>
</resources>
